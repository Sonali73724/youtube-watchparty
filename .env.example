# YouTube Watch Party - Environment Configuration

# Server Port
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youtube_watchparty?schema=public"

# Redis Pub/Sub Connection (For Socket.IO Horizontal Scaling)
# Optional in single-node dev mode (falls back gracefully to standalone in-memory)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets (JWT)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma-separated for multi-domain setups)
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://watchparty.vercel.app"
